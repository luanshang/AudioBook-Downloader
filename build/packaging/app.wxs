<?xml version="1.0" encoding="UTF-8"?>
<!--
  有声书下载器 MSI 安装包（WiX Toolset v4/v7）
  编译：
    1. 先生成 Components.wxs（Python 脚本遍历便携版目录生成）
    2. 再编译:
       wix build build\packaging\app.wxs build\packaging\Components.wxs -o build\output\AudioBook Downloader-v0.0.1.msi
  说明：安装到 %LocalAppData%\Programs\有声书下载器（per-user，应用运行时需要写 data/logs）。
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="有声书下载器"
           Manufacturer="AudioBook Downloader"
           Version="0.0.1"
           UpgradeCode="8F1C9E5A-2D4B-4A6F-BB33-7E3D5A1C9B42"
           Scope="perUser"
           Language="2052"
           InstallerVersion="500"
           Compressed="yes">
    <SummaryInformation Description="有声书下载器 v0.0.1 安装包" />

    <MajorUpgrade DowngradeErrorMessage="已安装更高版本，无法降级安装。" />

    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="LocalAppDataFolder" />

    <Property Id="ARPPRODUCTICON" Value="favicon.ico" />

    <Icon Id="favicon.ico" SourceFile="app\resources\favicon.ico" />

    <Feature Id="MainFeature" Title="有声书下载器" Level="1">
      <ComponentGroupRef Id="PortableFiles" />
    </Feature>

    <UIRef Id="WixUI_InstallDir" />
  </Package>
</Wix>